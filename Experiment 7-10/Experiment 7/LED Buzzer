const int led = 13;
const int pb = 2;
const int buzz = 8;

void setup() {
  pinMode(led, OUTPUT);
  pinMode(pb, INPUT_PULLUP);
  pinMode(buzz, OUTPUT);
}

void loop() {
  int buttonState = digitalRead(pb);

  if (buttonState == HIGH) {
    digitalWrite(led, HIGH);
    noTone(buzz);
  } else {
    digitalWrite(led, LOW);
    tone(buzz, 1200, 400);
  }
}
